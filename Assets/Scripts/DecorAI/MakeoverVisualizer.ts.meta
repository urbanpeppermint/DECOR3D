    - '// @input string imagenModel = "imagen-3.0-generate-002" {"hint":"Imagen model id (RSG Imagen proxy)."}'
    - '// @input string imagenAspectRatio = "16:9" {"hint":"Aspect ratio passed to Imagen. 16:9 reads as a natural room view.", "widget":"combobox", "values":[{"label":"16:9 (wide room view)", "value":"16:9"}, {"label":"4:3 (portrait-leaning)", "value":"4:3"}, {"label":"1:1 (square)", "value":"1:1"}]}'
