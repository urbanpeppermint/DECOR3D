    - '// @input SceneObject previewFrameRoot {"hint":"Optional parent of previewPlane (e.g. Scan_preview frame). Visibility only — layout stays as you placed it."}'
    - '// @input SceneObject loadingIndicator {"hint":"Show this SceneObject while Imagen is generating."}'
    - '// @input Component.Text statusText {"hint":"Optional Text component used for short status messages."}'
