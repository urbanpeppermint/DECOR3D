  InputLines:
    - '// @input string styleButtonBindingMode = "explicit" {"hint":"SIK: Scroll list + prefab rows under ScrollView content. Explicit = per-slot buttons.", "widget":"combobox", "values":[{"label":"Explicit (inspector slot per style)", "value":"explicit"}, {"label":"Scroll list (row children = styles in order)", "value":"scrollChildren"}]}'
    - '// @input SceneObject pickerRoot {"hint":"Root scaled to zero after a pick (usually the whole picker + scroll chrome)."}'
    - '// @input SceneObject scrollStyleRowsParent {"hint":"Parent of style row objects (e.g. PickerRoot). Children are stacked on local Y."}'
    - '// @input bool useWorldSpaceRows = true {"hint":"Off = SIK ScrollView row layout (ScreenTransform + offsets). On = Transform stack + StylePickerListScroll."}'
    - '// @input float rowYStart = 8 {"hint":"Local Y for row 0 (first style)."}'
    - '// @input float rowSpacing = 6 {"hint":"Local Y step per row (downward)."}'
    - '// @input AssignableType listScroll {"hint":"Optional — refreshed after rows spawn so thumb scroll range is correct."}'
    - '// @input float scrollItemYStart {"hint":"SIK row 0 center Y when StylePickerScrollContentCreator syncLayoutFromController is on."}'
    - '// @input float scrollItemYStep = -5.4 {"hint":"Legacy SIK ScrollView: vertical step per row."}'
    - '// @input float scrollRowWidth = 32 {"hint":"Legacy SIK ScrollView: row width (offsets)."}'
    - '// @input float scrollRowHeight = 5.4 {"hint":"Legacy SIK ScrollView: row height (offsets)."}'
    - '// @input Asset.ObjectPrefab styleRowPrefab {"hint":"Scroll list: one prefab instance per style under scrollStyleRowsParent (leave empty if rows are already in the scene)."}'
    - '// @input bool rebuildPrefabRowsOnStart {"hint":"Scroll list: destroy all children of scrollStyleRowsParent then recreate from styleRowPrefab (uses catalog count)."}'
    - '// @ui {"widget":"group_start", "label":"Buttons (explicit mode only)"}'
