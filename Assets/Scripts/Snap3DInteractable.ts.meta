  InputLines:
    - // @input SceneObject modelParent
    - // @input Component.Image img
    - // @input Component.Text promptDisplay
    - // @input SceneObject spinner
    - // @input Asset.Material mat
    - // @input SceneObject displayPlate
    - // @input SceneObject colliderObj
    - '// @input float promptHideDelaySeconds = 4 {"hint":"Seconds before the floating prompt label is hidden (success or error)."}'
    - '// @ui {"widget":"group_start", "label":"Surface Snapping"}'
    - '// @input bool enableSurfaceSnap = true {"hint":"Snap the 3D object to detected surfaces via WorldQueryModule."}'
    - '// @input bool hitTestFilter = true {"hint":"Smooth/filter the hit-test results for less jitter."}'
    - '// @input float surfaceRayLength = 200 {"hint":"Max ray length (cm) for initial surface detection (before first place)."}'
    - '// @input float snapProximityCm = 50 {"hint":"Max distance (cm) to snap to a surface on drag release. No snap if further."}'
    - '// @input bool horizontalSurfacesOnly = true {"hint":"Only snap to horizontal surfaces (floors/tables). Ignores walls and slopes."}'
    - '// @input float minHorizontalNormalY = 0.85 {"hint":"Min surface normal Y (1 = flat floor). 0.85 ≈ 32° max slope."}'
    - '// @input bool preserveRotationOnSnap = true {"hint":"On drag release: keep rotation, only move onto surface at drop X/Z."}'
    - '// @input bool resnapOnDrag = true {"hint":"Re-snap to surfaces when dragging the object to a new position."}'
    - '// @input bool anchorPivotAtBottom = true {"hint":"Deprecated — no longer affects placement. Snap height uses half display height + Surface Clearance. Use Surface Clearance (signed) to close the gap."}'
    - '// @input float surfaceClearanceCm {"hint":"Signed vertical offset (cm) applied after snap. Negative pulls the object DOWN onto the surface, positive lifts it. Lower this toward a negative value to close the gap."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Wall Snapping"}'
    - '// @input bool enableWallSnap = true {"hint":"Allow wall items (curtains, paintings, wall lamps, mirrors) to snap to nearby walls. Auto-enabled by the factory from the prompt; can also be forced on."}'
    - '// @input float wallSnapProximityCm = 50 {"hint":"Max distance (cm) to a wall on drag release for the item to snap to it."}'
    - '// @input float wallMaxNormalY = 0.3 {"hint":"A surface counts as a wall when |normal.y| is below this (0 = perfectly vertical). 0.3 ≈ up to ~17° tilt."}'
    - '// @input float wallClearanceCm = 2 {"hint":"Signed offset (cm) out from the wall along its normal. Increase if the item clips into the wall; use a small negative to sit flush."}'
    - '// @input bool wallFacingFlip {"hint":"Flip facing if the item ends up facing INTO the wall instead of into the room."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Ceiling Snapping"}'
    - '// @input bool enableCeilingSnap = true {"hint":"Allow ceiling items (hanging plants, ceiling/pendant lamps, chandeliers) to snap to the ceiling above. Auto-enabled by the factory from the prompt."}'
    - '// @input float ceilingSnapProximityCm = 80 {"hint":"Max distance (cm) to the ceiling on drag release for the item to snap up to it."}'
    - '// @input float ceilingMinNormalDownY = 0.85 {"hint":"A surface counts as a ceiling when its normal points down past this (1 = perfectly flat ceiling). 0.85 ≈ up to ~32° tilt."}'
    - '// @input float ceilingDropCm = 20 {"hint":"How far (cm) the item hangs BELOW the ceiling hit. Increase for a longer cord/chain."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Display Size"}'
    - '// @input float baseDisplaySize = 40 {"hint":"Base size (cm) for the 2D preview, collider scale, and center-pivot placement."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Manipulation"}'
    - '// @input bool canTranslate = true {"hint":"Allow single-hand pinch-drag to move the item."}'
    - '// @input bool canRotate = true {"hint":"Allow two-hand pinch to rotate the item on its anchor."}'
    - '// @input bool canScale = true {"hint":"Allow two-hand pinch (spread/pinch) to scale the item."}'
    - '// @input float minScaleFactor = 0.3 {"hint":"Minimum scale factor (relative to original)."}'
    - '// @input float maxScaleFactor = 15 {"hint":"Maximum scale factor (relative to original pinch size)."}'
    - '// @ui {"widget":"group_end"}'
